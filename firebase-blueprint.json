{
  "entities": {
    "UserSettings": {
      "title": "UserSettings",
      "description": "User sleep targets, default snooze preferences, and sunrise configuration.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated owner UID."
        },
        "targetSleepMinutes": {
          "type": "integer",
          "description": "Daily target sleep duration in minutes (180..720)."
        },
        "defaultSnoozeMinutes": {
          "type": "integer",
          "description": "Default snooze interval in minutes (1..30)."
        },
        "defaultSnoozeMaxCount": {
          "type": "integer",
          "description": "Default maximum snooze repeats (0..10)."
        },
        "defaultRampSeconds": {
          "type": "integer",
          "description": "Default gradual volume ramp duration in seconds (0..300)."
        },
        "sunriseGlowEnabled": {
          "type": "boolean",
          "description": "Whether sunrise screen illumination is enabled by default."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "userId",
        "targetSleepMinutes",
        "defaultSnoozeMinutes",
        "defaultSnoozeMaxCount",
        "defaultRampSeconds",
        "sunriseGlowEnabled",
        "createdAt",
        "updatedAt"
      ]
    },
    "AlarmProfile": {
      "title": "AlarmProfile",
      "description": "Configurable alarm with recurring snooze cadence, custom sound, ramp, and linked morning routine.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated owner UID."
        },
        "label": {
          "type": "string",
          "description": "Alarm label up to 60 characters."
        },
        "hour": {
          "type": "integer",
          "description": "Hour of day (0..23)."
        },
        "minute": {
          "type": "integer",
          "description": "Minute of hour (0..59)."
        },
        "repeatDays": {
          "type": "array",
          "description": "ISO weekday numbers 1..7 (max 7)."
        },
        "enabled": {
          "type": "boolean",
          "description": "Whether the alarm is active."
        },
        "vibrate": {
          "type": "boolean",
          "description": "Whether haptic vibration accompanies the alarm."
        },
        "soundId": {
          "type": "string",
          "description": "Identifier for built-in chime, system ringtone, or custom file."
        },
        "soundTitle": {
          "type": "string",
          "description": "Display title of the chosen alert sound."
        },
        "soundUri": {
          "type": "string",
          "description": "Optional URI string for system ringtone or SAF audio file."
        },
        "rampSeconds": {
          "type": "integer",
          "description": "Gradual volume fade-in duration in seconds (0..300)."
        },
        "maxVolumePercent": {
          "type": "integer",
          "description": "Target maximum alarm volume percentage (10..100)."
        },
        "sunriseEnabled": {
          "type": "boolean",
          "description": "Whether to animate sunrise glow on wake screen."
        },
        "snoozeMode": {
          "type": "string",
          "enum": ["FIXED", "DIMINISHING", "CUSTOM"],
          "description": "Recurring snooze interval strategy."
        },
        "snoozeIntervalMinutes": {
          "type": "integer",
          "description": "Base snooze interval in minutes (1..30)."
        },
        "snoozeMaxCount": {
          "type": "integer",
          "description": "Maximum allowed recurring snoozes (0..10)."
        },
        "snoozeSequenceMinutes": {
          "type": "array",
          "description": "Explicit per-cycle snooze intervals in minutes (max 10)."
        },
        "linkedRoutineId": {
          "type": "string",
          "description": "Optional ID of morning routine launched on dismissal."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "userId",
        "label",
        "hour",
        "minute",
        "repeatDays",
        "enabled",
        "vibrate",
        "soundId",
        "soundTitle",
        "rampSeconds",
        "maxVolumePercent",
        "sunriseEnabled",
        "snoozeMode",
        "snoozeIntervalMinutes",
        "snoozeMaxCount",
        "snoozeSequenceMinutes",
        "createdAt",
        "updatedAt"
      ]
    },
    "MorningRoutine": {
      "title": "MorningRoutine",
      "description": "Ordered morning routine checklist template with per-step habit timer durations.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated owner UID."
        },
        "title": {
          "type": "string",
          "description": "Routine title up to 60 characters."
        },
        "defaultRoutine": {
          "type": "boolean",
          "description": "Whether this routine is the user's primary morning flow."
        },
        "steps": {
          "type": "array",
          "description": "Bounded list (max 20) of routine step objects."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "userId",
        "title",
        "defaultRoutine",
        "steps",
        "createdAt",
        "updatedAt"
      ]
    },
    "RoutineRun": {
      "title": "RoutineRun",
      "description": "Recorded completion run of a morning routine habit timer session.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated owner UID."
        },
        "routineId": {
          "type": "string",
          "description": "ID of the completed or partial routine."
        },
        "routineTitle": {
          "type": "string",
          "description": "Snapshot title of the routine."
        },
        "dateKey": {
          "type": "string",
          "description": "Local date key YYYY-MM-DD."
        },
        "completedStepCount": {
          "type": "integer",
          "description": "Number of completed steps (0..20)."
        },
        "totalStepCount": {
          "type": "integer",
          "description": "Total steps in routine (1..20)."
        },
        "elapsedSeconds": {
          "type": "integer",
          "description": "Total elapsed habit timer duration in seconds (0..86400)."
        },
        "completed": {
          "type": "boolean",
          "description": "Whether all steps were finished."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "userId",
        "routineId",
        "routineTitle",
        "dateKey",
        "completedStepCount",
        "totalStepCount",
        "elapsedSeconds",
        "completed",
        "createdAt",
        "updatedAt"
      ]
    },
    "SleepLog": {
      "title": "SleepLog",
      "description": "Manual sleep session log and morning readiness check-in metrics.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated owner UID."
        },
        "dateKey": {
          "type": "string",
          "description": "Morning date key YYYY-MM-DD."
        },
        "bedtimeEpochMs": {
          "type": "integer",
          "description": "Bedtime epoch milliseconds."
        },
        "wakeEpochMs": {
          "type": "integer",
          "description": "Wake time epoch milliseconds."
        },
        "durationMinutes": {
          "type": "integer",
          "description": "Total sleep duration in minutes (15..1440)."
        },
        "qualityRating": {
          "type": "integer",
          "description": "Subjective sleep quality rating (1..5)."
        },
        "snoozeCountUsed": {
          "type": "integer",
          "description": "Number of recurring snoozes used that morning (0..20)."
        },
        "energyScore": {
          "type": "integer",
          "description": "Morning readiness energy check-in score (1..10)."
        },
        "mood": {
          "type": "string",
          "enum": ["REFRESHED", "STEADY", "GROGGY", "TIRED"],
          "description": "Morning wake mood tag."
        },
        "readinessScore": {
          "type": "integer",
          "description": "Composite morning readiness score (0..100)."
        },
        "tags": {
          "type": "array",
          "description": "Lifestyle factor tags (max 10)."
        },
        "notes": {
          "type": "string",
          "description": "Optional sleep reflection notes up to 300 characters."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "userId",
        "dateKey",
        "bedtimeEpochMs",
        "wakeEpochMs",
        "durationMinutes",
        "qualityRating",
        "snoozeCountUsed",
        "energyScore",
        "mood",
        "readinessScore",
        "tags",
        "notes",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/preferences/{prefId}": {
      "schema": { "$ref": "#/entities/UserSettings" },
      "description": "Per-user sleep target and alarm defaults (settings document)."
    },
    "/users/{userId}/alarms/{alarmId}": {
      "schema": { "$ref": "#/entities/AlarmProfile" },
      "description": "Per-user alarm profiles with recurring snooze intervals and custom alert sounds."
    },
    "/users/{userId}/routines/{routineId}": {
      "schema": { "$ref": "#/entities/MorningRoutine" },
      "description": "Per-user morning routine templates and checklist steps."
    },
    "/users/{userId}/routineRuns/{runId}": {
      "schema": { "$ref": "#/entities/RoutineRun" },
      "description": "Per-user completed morning routine habit timer logs."
    },
    "/users/{userId}/sleepLogs/{logId}": {
      "schema": { "$ref": "#/entities/SleepLog" },
      "description": "Per-user manual sleep logs and morning readiness check-ins."
    }
  }
}
